# Environment for submit_field_spinup.sh / Cluster_Field_Spinup_Task.
# Copy to field_spinup.env and edit.  Paths are POSIX paths on the cluster.
#
# The Control 2 diagnostic grid used in development: 15 m cells under a
# 50 % coverage rule (54 cells), Kantola case 5 physics with the hourly
# Kantola forcing used directly (2009-2016 cycled, 2017 handoff).  For the
# production grid drop TC_CELL_M and TC_MIN_COVERAGE (calibrated 2.33 m,
# 95 % rule, 1461 cells on Control 2).

TC_ROOT=$HOME/project_pi_<netid>/TC-SMEW-N          # folder holding v2
TC_SHAPEFILE="$TC_ROOT/v2/Spatial inputs/Bruce Farm Virginia/Whole farm/AdamWilbourne_Control_Fields.shp"
TC_DEM="$TC_ROOT/v2/Spatial inputs/Bruce Farm Virginia/DEM"
TC_AGRONOMIC_FILE="$TC_ROOT/v2/T&C_Code/Inputs/Field_Spinup/diagnostic_Control2_15m/Cell_Agronomic_merged.csv"
TC_OUTPUT_DIR=$HOME/scratch_pi_<netid>/TC-SMEW-N/Control2_15m_truth   # scratch is purged after 30 days: copy results out

TC_METHOD=per_cell          # per_cell = truth for every cell (validation); rf = the RF path
TC_FEATURES="1 2 3"
TC_POLYGON=1
TC_CELL_M=15
TC_MIN_COVERAGE=0.5
TC_SUBSAMPLE=0.2            # rf only
TC_CASE=5

# Spin-up columns the Kantola workbook row does not carry
TC_FORCING_FILE=Data_Kantola.mat
TC_METEO_FILE=Data_Kantola.mat
TC_METEO_START=2009-01-01
TC_METEO_END=2020-12-31
TC_TRANSIENT_START=2017-01-01
TC_TRANSIENT_END=2017-12-31

# Validation design (per_cell runs only)
TC_VALIDATE=1
TC_VALIDATION_FRACTIONS="0.10 0.15 0.20 0.30"
TC_VALIDATION_SEEDS="1 2 3 4 5"
# TC_RF_STATES_DIR=$HOME/scratch_pi_<netid>/TC-SMEW-N/Control2_15m_rf   # score an rf run against the truth
